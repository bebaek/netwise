{
  "name": "netwise-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc -b --noEmit",
    "test:e2e": "../scripts/run-e2e-isolated.sh",
    "test:e2e:local": "playwright test",
    "test:e2e:demo": "../scripts/run-e2e-isolated.sh",
    "test:e2e:seed:local": "docker compose -f ../docker-compose.yml exec -T backend python -m app.seed_demo --reset",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1"
  }
}
